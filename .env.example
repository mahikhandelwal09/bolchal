# BolChal Environment Configuration
# BolChal is a fully client-side application running on standard Web APIs (Web Audio, MediaStream, MediaRecorder).
# No external API keys or server credentials are required for local development.

# Optional: Port configuration for Vite dev server (default is 5173)
VITE_PORT=5173

# Optional: Host configuration (e.g., 0.0.0.0 or localhost)
VITE_HOST=localhost
